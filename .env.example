# Copy this file to .env and fill in your real values. Never commit .env itself.
PORT=3000

# PostgreSQL connection settings (local development)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=inventory_app

# When set (e.g. on Railway), DATABASE_URL takes priority over the PG* vars above.
# DATABASE_URL=postgresql://user:password@host:port/database
