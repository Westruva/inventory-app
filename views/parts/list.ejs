<%- include('../partials/header', { title: 'Parts' }) %>

<div class="page-header">
	<h1>Parts</h1>
	<a class="btn" href="/parts/new">+ New Part</a>
</div>

<form class="filter-bar" method="get" action="/parts">
	<input type="text" name="q" placeholder="Search name or part #" value="<%= q %>" />
	<input type="text" name="category" placeholder="Category" value="<%= category %>" />
	<button type="submit">Filter</button>
	<a href="/parts">Clear</a>
</form>

<table>
	<thead>
		<tr>
			<th>Part #</th>
			<th>Name</th>
			<th>Brand</th>
			<th>Category</th>
			<th>Cost</th>
			<th>Retail</th>
			<th>On Hand</th>
		</tr>
	</thead>
	<tbody>
		<% parts.forEach(part => { %>
			<tr>
				<td><a href="/parts/<%= part.part_id %>"><%= part.part_number %></a></td>
				<td><%= part.part_name %></td>
				<td><%= part.brand || '-' %></td>
				<td><%= part.category || '-' %></td>
				<td>$<%= part.cost %></td>
				<td>$<%= part.retail_price %></td>
				<td class="<%= part.quantity_on_hand <= part.reorder_level ? 'warn' : '' %>"><%= part.quantity_on_hand %></td>
			</tr>
		<% }) %>
		<% if (parts.length === 0) { %>
			<tr><td colspan="7">No parts found.</td></tr>
		<% } %>
	</tbody>
</table>

<%- include('../partials/footer') %>
