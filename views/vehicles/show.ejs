<%- include('../partials/header', { title: `${vehicle.make} ${vehicle.model}` }) %>

<div class="page-header">
	<h1><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %></h1>
	<div>
		<a class="btn" href="/vehicles/<%= vehicle.vehicle_id %>/edit">Edit</a>
		<form method="post" action="/vehicles/<%= vehicle.vehicle_id %>/delete" class="inline" onsubmit="return confirm('Delete this vehicle?')">
			<button type="submit" class="btn danger">Delete</button>
		</form>
	</div>
</div>

<dl class="details">
	<dt>Engine/Trim</dt><dd><%= vehicle.engine_trim || '-' %></dd>
</dl>

<h2>Compatible Parts</h2>
<% if (fittedParts.length === 0) { %>
	<p>No parts linked yet.</p>
<% } else { %>
	<ul class="linked-list">
		<% fittedParts.forEach(p => { %>
			<li>
				<a href="/parts/<%= p.part_id %>"><%= p.part_name %> (<%= p.part_number %>)</a>
				<form method="post" action="/fitment/<%= p.fitment_id %>/delete" class="inline" onsubmit="return confirm('Remove this fitment?')">
					<input type="hidden" name="redirect_to" value="/vehicles/<%= vehicle.vehicle_id %>" />
					<button type="submit" class="btn small danger">Remove</button>
				</form>
			</li>
		<% }) %>
	</ul>
<% } %>

<h3>Link a Part</h3>
<form method="post" action="/fitment" class="inline-form">
	<input type="hidden" name="vehicle_id" value="<%= vehicle.vehicle_id %>" />
	<input type="hidden" name="redirect_to" value="/vehicles/<%= vehicle.vehicle_id %>" />
	<select name="part_id" required>
		<option value="" disabled selected>Select a part</option>
		<% allParts.forEach(p => { %>
			<option value="<%= p.part_id %>"><%= p.part_name %> (<%= p.part_number %>)</option>
		<% }) %>
	</select>
	<button type="submit">Link</button>
</form>

<p><a href="/vehicles">Back to vehicles</a></p>

<%- include('../partials/footer') %>
